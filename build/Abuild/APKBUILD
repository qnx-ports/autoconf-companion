pkgname=autoconf
pkgver=2.72
pkgrel=0
pkgdesc="GNU tool for automatically configuring source code"
url="https://www.gnu.org/software/autoconf"
arch="all"
depends="perl m4"
license="GPL-3.0-or-later WITH Autoconf-exception-3.0"
subpackages="$pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/autoconf/autoconf-$pkgver.tar.gz"

build() {
   if [[ $CBUILD = $CHOST ]]; then
        # Compile natively
        echo "No additional arguments are required"
    else
        # Cross compiling
        echo "This can not be cross-compiled"
        exit 1;
    fi

   CHOST="$CHOST" \
   ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        CFLAGS=-D_QNX_SOURCE \
        LDFLAGS="-lm -lregex -lsocket -lgcc_s"

    make
}

package() {
    make DESTDIR="$pkgdir/" install
}


